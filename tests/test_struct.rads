// Test: struct module
// Binary data contract (post memory-safety fix):
//   struct.pack(...)        -> array of byte ints (0-255), like list(struct.pack(...)) in Python 3
//   struct.unpack*(fmt, x)  -> accepts byte-int array OR string, bounds-checked

// ---- calcsize ----
let s = struct.calcsize(">i")
assert(s == 4, "calcsize i = 4")

let s2 = struct.calcsize(">ih")
assert(s2 == 6, "calcsize ih = 6")

let s3 = struct.calcsize("<Qd")
assert(s3 == 16, "calcsize Qd = 16")

// ---- pack returns a byte array of exactly calcsize() bytes ----
let packed = struct.pack(">i", 42)
assert(array.count(packed) == 4, "pack('>i') yields exactly 4 bytes")
assert(packed[0] == 0 && packed[1] == 0 && packed[2] == 0 && packed[3] == 42,
       "pack('>i', 42) bytes are [0,0,0,42]")

// round-trip: int
let vals = struct.unpack(">i", packed)
assert(vals[0] == 42, "pack/unpack int 42")

// round-trip: short
let packed2 = struct.pack("<h", -100)
assert(array.count(packed2) == 2, "pack('<h') yields exactly 2 bytes")
assert(packed2[0] == 156 && packed2[1] == 255, "pack('<h', -100) bytes are [156,255]")
let vals2 = struct.unpack("<h", packed2)
assert(vals2[0] == -100, "pack/unpack short -100")

// round-trip: unsigned short
let packed3 = struct.pack(">H", 50000)
assert(array.count(packed3) == 2, "pack('>H') yields exactly 2 bytes")
assert(packed3[0] == 195 && packed3[1] == 80, "pack('>H', 50000) bytes are [195,80]")
let vals3 = struct.unpack(">H", packed3)
assert(vals3[0] == 50000, "pack/unpack ushort 50000")

// round-trip: byte
let packed4 = struct.pack("<B", 255)
assert(array.count(packed4) == 1 && packed4[0] == 255, "pack('<B',255) = [255]")
let vals4 = struct.unpack("<B", packed4)
assert(vals4[0] == 255, "pack/unpack byte 255")

// round-trip: signed byte
let packed5 = struct.pack("<b", -128)
assert(array.count(packed5) == 1 && packed5[0] == 128, "pack('<b',-128) = [128]")
let vals5 = struct.unpack("<b", packed5)
assert(vals5[0] == -128, "pack/unpack sbyte -128")

// round-trip: bool
let packed6 = struct.pack("<?", 1)
assert(array.count(packed6) == 1 && packed6[0] == 1, "pack('<?',1) = [1]")
let vals6 = struct.unpack("<?", packed6)
assert(vals6[0] == true, "pack/unpack bool true")

// round-trip: multi-field
let packed7 = struct.pack(">iHb", 1000, 200, 42)
assert(array.count(packed7) == 7, "pack('>iHb') yields exactly 7 bytes")
assert(packed7[0] == 0 && packed7[3] == 232 && packed7[6] == 42,
       "pack('>iHb',1000,200,42) key bytes")
let vals7 = struct.unpack(">iHb", packed7)
assert(vals7[0] == 1000, "multi-field i")
assert(vals7[1] == 200, "multi-field H")
assert(vals7[2] == 42, "multi-field b")

// round-trip: float
let packed8 = struct.pack("<f", 3.14)
assert(array.count(packed8) == 4, "pack('<f') yields exactly 4 bytes")
let vals8 = struct.unpack("<f", packed8)
assert(vals8[0] > 3.0 && vals8[0] < 3.3, "pack/unpack float ~3.14")

// round-trip: double
let packed9 = struct.pack(">d", 2.718281828)
assert(array.count(packed9) == 8, "pack('>d') yields exactly 8 bytes")
let vals9 = struct.unpack(">d", packed9)
assert(vals9[0] > 2.718 && vals9[0] < 2.719, "pack/unpack double ~2.718")

// ---- 64-bit round-trips (byte-level) ----
let pq = struct.pack("<q", 1)
assert(array.count(pq) == 8, "pack('<q') yields exactly 8 bytes")
assert(pq[0] == 1 && pq[7] == 0, "pack('<q',1) LE bytes [1,0,0,0,0,0,0,0]")
let vq = struct.unpack("<q", pq)
assert(vq[0] == 1, "pack/unpack q 1")

let pd = struct.pack("<q", -2)
assert(pd[0] == 254 && pd[7] == 255, "pack('<q',-2) LE two's complement")

// ---- char format ----
let pc = struct.pack(">c", "A")
assert(array.count(pc) == 1 && pc[0] == 65, "pack('>c','A') = [65]")
let vc = struct.unpack(">c", pc)
assert(vc[0] == "A", "unpack 'c' returns 'A'")

// ---- unpack accepts plain strings too ----
let from_str = struct.unpack(">bB", "AZ")   // A=65, Z=90
assert(from_str[0] == 65 && from_str[1] == 90, "unpack from string 'AZ'")

// ---- pack_into / unpack_from ----
let buf = struct.pack(">iH", 100, 500)
let from_vals = struct.unpack_from(">H", buf, 4)
assert(from_vals[0] == 500, "unpack_from at offset")

let grown = struct.pack_into(">B", buf, 10, 7)
assert(array.count(grown) == 11, "pack_into grows buffer to 11")
assert(grown[4] == 1 && grown[5] == 244, "pack_into preserves original bytes")
assert(grown[10] == 7, "pack_into writes at offset 10")
let back = struct.unpack_from(">B", grown, 10)
assert(back[0] == 7, "pack_into/unpack_from round-trip at grown offset")

// ---- iter_unpack ----
let multi = struct.pack("<hh", 10, 20)
assert(array.count(multi) == 4, "pack('<hh') yields exactly 4 bytes")
let records = struct.iter_unpack("<h", multi)
assert(array.count(records) == 2, "iter_unpack count")
assert(records[0][0] == 10, "iter_unpack first")
assert(records[1][0] == 20, "iter_unpack second")

// ---- bounds checking: short buffers must fail cleanly, not read OOB ----
let too_short = struct.unpack(">i", [1, 2, 3])      // needs 4, has 3
assert(too_short == null, "unpack rejects 3-byte buffer for '>i'")

let too_short2 = struct.unpack_from(">i", [1, 2, 3], 0)
assert(too_short2 == null, "unpack_from rejects short buffer")

let too_short3 = struct.unpack_from(">i", [1, 2, 3, 4], 1)  // 4-1=3 < 4
assert(too_short3 == null, "unpack_from rejects offset past end")

let tail_ok = struct.unpack_from(">B", [1, 2, 3, 4], 3)
assert(tail_ok[0] == 4, "unpack_from at last valid offset still works")

let partial = struct.iter_unpack("<hh", [1, 2, 3])   // 3 bytes, record=2: 1 full record
let rec = struct.iter_unpack("<h", [1, 2, 3])
assert(array.count(rec) == 1, "iter_unpack floors partial trailing record")
assert(rec[0][0] == 1 || rec[0][0] == 513, "iter_unpack record value (endianness-safe)")

let no_recs = struct.iter_unpack(">i", [1])
assert(array.count(no_recs) == 0, "iter_unpack too-short -> empty result")

let bad_off = struct.pack_into(">B", [1, 2], -1, 9)
assert(bad_off == null, "pack_into rejects negative offset")

print("struct module: all tests passed")
