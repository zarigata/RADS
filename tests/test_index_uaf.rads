// Regression (run 13): AST_INDEX_EXPR / BC_GETIDX shared nested arrays.
// Reading a nested-array element shared elem.array_val with NO refcount
// bump, then value_free(&arr) dropped the container. Literal temps like
// [[1,2],[3,4]][1] have no other owner -> rc hits 0 -> items freed -> the
// shared result dangles (heap-use-after-free at next touch or teardown).
// Chained grid[1][0] double-freed the inner array at teardown.
// Fix: bump refcount on the shared-element path in BOTH the tree-walker
// (eval_expression index case) and BC_GETIDX (kept bit-identical).

blast main() {
    // Shape A: literal-temp container, result used afterwards
    turbo x = [[1,2],[3,4]][1];
    echo(x[0] + x[1]);                    // expect 7
    echo([[9,8],[7,6]][0][1]);            // expect 8

    // Shape B: chained index on a named container
    turbo grid = [[1,2],[3,4],[5,6]];
    echo(grid[1][0] + grid[2][1]);        // expect 9

    // Shape C: container survives, result reassigned (bump must not leak
    // or double-free across reassignment churn)
    cruise (i in 0..50) {
        turbo row = grid[i % 3];
        echo(row[0]);
    }

    // Shape D: nested thrice
    turbo deep = [[ [1,2], [3,4] ], [ [5,6] ]];
    echo(deep[0][1][0]);                  // expect 3
    echo(deep[1][0][1]);                  // expect 6

    if (x[0] + x[1] == 7 && grid[1][0] + grid[2][1] == 9 && deep[0][1][0] == 3) {
        echo("PASS: index shared-array refcount correct");
    } else {
        echo("FAIL: index shared-array refcount broken");
    }
}
