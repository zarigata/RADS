# Export exponential/logarithmic
export exp, log, log2, log10, log_base, pow, sqrt, cbrt, nth_root;

# Export statistics
export mean, median, mode, variance, std_dev;
export skewness, kurtosis, summary, linear_regression;

# Export vector operations
export vec_dot, vec_magnitude, vec_normalize;
export vec_add, vec_sub, vec_scale, vec_angle, vec_cross;

# Export matrix operations
export mat_identity, mat_add, mat_multiply, mat_transpose;
export mat_determinant, mat_minor;

# Export utilities
export lerp, clamp, sign, abs, frac, mod, wrap, smooth_step;