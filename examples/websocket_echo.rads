// WebSocket echo example — real API (nightshift 20261101)
// The old version called websocket_new()/websocket_on_message() — natives
// that NEVER existed (silent no-ops before honest-failure). ws.server_new/
// ws.send_text/ws.close are the real surface; this demo stays offline-safe:
// it exercises the handle lifecycle without binding a port.

blast main() {
    echo("ws natives present:")
    let h = ws.server_new(0)
    echo("server_new -> " + type(h))
    ws.close(h)
    echo("closed ok")
    return 0
}
main()
