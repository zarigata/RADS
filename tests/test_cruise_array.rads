// Regression (run 19): `cruise i in <array>` silently executed ZERO iterations.
// The tree-walker only handled OP_RANGE iterables; any array iterable
// (literal, variable, or call result) fell through with no diagnostic.
// Also covers: parens-optional `cruise (i in ...)`, break/continue,
// string element binding, and nested arrays.
blast main() {
    // 1. literal array, paren'd form
    turbo sum1 = 0;
    cruise (i in [1, 2, 3]) {
        sum1 = sum1 + i;
    }
    echo(sum1);            // expect 6

    // 2. variable array, no-paren form, body assigns loop var name
    turbo items = ["a", "b"];
    turbo n = 0;
    cruise i in items {
        n = n + 1;
    }
    echo(n);               // expect 2

    // 3. break
    turbo first_stop = 0;
    cruise (i in [1, 2, 3, 4]) {
        if (i >= 3) { break; }
        first_stop = first_stop + i;
    }
    echo(first_stop);      // expect 3 (1+2)

    // 4. continue inside range loop still fine
    turbo odd_sum = 0;
    cruise (i in 0..6) {
        if (i % 2 == 0) { continue; }
        odd_sum = odd_sum + i;
    }
    echo(odd_sum);         // expect 9 (1+3+5)

    // 5. strings bind as copies
    turbo words = ["x", "yy"];
    cruise w in words {
        echo(w);
    }                      // expect x then yy

    // 6. nested arrays iterate their inner arrays
    turbo pairs = [[1, 2], [3, 4]];
    turbo flat = 0;
    cruise pair in pairs {
        cruise v in pair {
            flat = flat + v;
        }
    }
    echo(flat);            // expect 10

    // 7. struct literal NOT swallowed by the block heuristic
    echo("struct-literal-colon still parses below");
    turbo m = {name: "rads", n: 2};
    echo(m);
}
