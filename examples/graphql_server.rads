// GraphQL parse example — real API (nightshift 20261101)
// The old version called graphql_schema()/graphql_add_type() and friends —
// natives that NEVER existed; before honest-failure they were silent no-ops.
// This one uses the real graphql.parse surface.

blast main() {
    let query = `{ "query": "{ user(id: 1) { name email } }" }`
    let parsed = graphql.parse(query)
    echo("parsed query type: " + type(parsed))
    let ok = `{"query":"{ user(id: 1) { name email } }"}`
    let p2 = graphql.parse(ok)
    echo("graphql.parse works: " + (p2 != null))
    return 0
}
main()
